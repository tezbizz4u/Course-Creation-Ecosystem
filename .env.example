# Local PostgreSQL WASM development; never enable on Cloud Run.
LOCAL_DATABASE=1
ALLOW_REGISTRATION=1
AUTH_URL=http://localhost:3000
# Production: disable LOCAL_DATABASE, set DATABASE_URL and AUTH_SECRET securely.
# DATABASE_URL=postgresql://...
# AUTH_SECRET= (secure value required in production)
# Optional Gemini adapter: no request is made without an explicit Generate action.
# GEMINI_API_KEY= (supply securely)
# AI_MODEL= (approved Gemini model ID)
# AI_MAX_REQUESTS_PER_DAY=5
# AI_ENABLED=1
